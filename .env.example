# Wanda Central Environment Variables

# Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/wanda_central
# Or use Supabase URL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GCTR Integration
GCTR_API_KEY=your-gctr-api-key

# Mentions Integration
MENTIONS_API_KEY=your-mentions-api-key
MENTIONS_BASE_URL=https://mentions-api.example.com

# Application
NODE_ENV=development
PORT=3000

# Redis (for job queue - optional, can use in-memory for dev)
REDIS_URL=redis://localhost:6379

# Authentication (if using custom auth)
JWT_SECRET=your-jwt-secret-here

# Trello Integration (optional)
TRELLO_API_KEY=
TRELLO_TOKEN=
